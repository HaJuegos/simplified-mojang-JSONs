{
    "name": "simplified-mojang-jsons",
    "version": "0.0.2",
    "description": "An API in TypeScript for creating and managing the JSON configuration of vanilla and custom Minecraft Bedrock entities using type system support, OOP, and a more organized and reusable structure.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./exporttojson": "./scripts/exporttojson.ts",
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HaJuegos/simplified-mojang-JSONs.git"
    },
    "bugs": {
        "url": "https://github.com/HaJuegos/simplified-mojang-JSONs/issues"
    },
    "homepage": "https://github.com/HaJuegos/simplified-mojang-JSONs#readme",
    "files": [
        "dist",
        "scripts/exporttojson.ts",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "node scripts/clean.mjs && node scripts/bundle.mjs && tsc --emitDeclarationOnly",
        "typecheck": "tsc --noEmit",
        "generatepaths": "tsx scripts/autoIndexes.ts",
        "exportjson": "tsx scripts/exporttojson.ts",
        "prepublishOnly": "pnpm build"
    },
    "author": "HaJuegos",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "minecraft",
        "bedrock",
        "scripting",
        "addon",
        "api",
        "events",
        "wrapper",
        "mojang"
    ],
    "devDependencies": {
        "@minecraft/debug-utilities": "1.0.0-beta.1.26.52-stable",
        "@minecraft/gameplay-utilities": "1.3.1",
        "@minecraft/server": "2.11.0-beta.1.26.52-stable",
        "@minecraft/server-gametest": "1.0.0-beta.1.26.52-stable",
        "@minecraft/server-graphics": "1.1.0-beta.1.26.52-stable",
        "@minecraft/server-net": "1.0.0-beta.1.26.52-stable",
        "@minecraft/server-ui": "2.3.0-beta.1.26.52-stable",
        "@minecraft/vanilla-data": "1.26.52",
        "@types/node": "26.6.5",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15",
        "typescript": "7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@12.15.0",
    "dependencies": {
        "@minecraft/vanilla-data": "1.26.52"
    }
}
